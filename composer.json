{
  "name": "troisieme/overdog",
  "description": "A Craft CMS scaffolding project",
  "version": "2.0.0",
  "keywords": [
    "Craft CMS starter",
    "Craft CMS boilerplate",
    "Overdog",
    "Craft CMS",
    "troisième",
    "3ejoueur"
  ],
  "support": {
    "docs": "https://st.overdog.io"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "troisième",
      "homepage": "https://troisieme.ca/"
    }
  ],
  "type": "project",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "craftcms/aws-s3": "2.2.3",
    "craftcms/ckeditor": "^4.9.0",
    "craftcms/cms": "5.8.3",
    "ianreid/switcher": "^1.1",
    "nystudio107/craft-retour": "5.0.11",
    "vlucas/phpdotenv": "^5.4.0"
  },
  "require-dev": {
    "craftcms/generator": "^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "yiisoft/yii2-composer": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php -r \"unlink('config/license.key');\"",
      "@composer dump-autoload -o"
    ],
    "post-install-cmd": [
      "@php -r \" define('HTSRC', 'web/.htaccess_' . getenv('CRAFT_ENVIRONMENT')); echo (file_exists(HTSRC) && copy(HTSRC, 'web/.htaccess')) ? HTSRC.' copied to web/.htaccess'.PHP_EOL : ''; \"",
      "@php craft install/check && php craft clear-caches/compiled-templates --interactive=0 || exit 0",
      "@php craft install/check && php craft up/index --interactive=0 || exit 0"
    ]
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ],
  "autoload": {
    "psr-4": {
      "modules\\tjcustomadminnotices\\": "modules/tjcustomadminnotices/",
      "modules\\tjckeditorcurcustomizations\\": "modules/tjckeditorcustomizations/src/"
    }
  }
}