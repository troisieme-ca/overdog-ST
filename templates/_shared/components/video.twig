{# PARAMETERS WHEN INCLUDE
    @param {string} sectionTitle
    @param {string} videoTitle
    @param {string} videoSource
    @param {string} videoId
#}

{% set sectionTitle = sectionTitle|default(null) %}

{% if videoSource and videoId %}
<div class="bg-transparent mb-full">
    <div class="container">
        <div class="max-w-screen-lg mx-auto">
            {% if sectionTitle %}
            <h2>{{ sectionTitle }}</h2>
            {% endif %}

            <div class="aspect-16/9 overflow-hidden" data-lazy-iframe="wrapper">
                {% if videoSource == 'vimeo' %}
                <lazy-iframe 
                    title="{{ videoTitle }}" 
                    src="https://player.vimeo.com/video/{{ videoId }}" 
                    width="100%" 
                    height="100%" 
                    frameborder="0"
                    allowfullscreen
                >
                </lazy-iframe>
                {% else %} {# else youtube #}
                <lazy-iframe 
                    width="100%" 
                    height="100%"
                    src="https://www.youtube.com/embed/{{ videoId }}?autoplay=0&origin={{ siteUrl }}" 
                    title="{{ videoTitle }}"
                    frameborder="0"
                    allowfullscreen
                >
                </lazy-iframe>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endif %}