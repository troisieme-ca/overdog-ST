{# PARAMETERS WHEN INCLUDE
   @param {string} title
   @param {object} documents
   @param {array} links
#}

{% if documents|length or (links|length and links[0].linkText and links[0].linkUrl) %}
<div class="bg-transparent mb-full">
    <div class="container">
        <div class="bg-blue-100 text-blue-900">
            <div class="bg-blue-900 text-white px-6 py-3 text-center">
                {{ title|default('Documents and links'|t) }}
            </div>
            <div class="p-8">
                <ul class="grid md:grid-cols-2 gap-x-half gap-y-quarter">
                    {# Documents #}
                    {% if documents|length %}
                        {% for document in documents %}
                        <li>
                            {{ include('_shared/atoms/link-with-icon', {
                                label: document.title,
                                value: document.url,
                                target: true,
                                icon: 'ic-download'
                            }, with_context = false, ignore_missing = true) }}
                        </li>
                        {% endfor %} 
                    {% endif %}

                    {# Links #}
                    {% if links|length %}
                        {% for link in links %}
                        <li>
                            {{ include('_shared/atoms/link-with-icon', {
                                label: link.linkText,
                                value: link.linkUrl,
                                target: link.linkTarget,
                                icon: link.linkTarget ? 'ic-external-link' : 'ic-link'
                            }, with_context = false, ignore_missing = true) }}
                        </li>
                        {% endfor %} 
                    {% endif %}
                </ul>
            </div>
        </div>
    </div>
</div>
{% endif %}