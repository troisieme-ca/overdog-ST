{% extends '_base/layout' %}

{% set plainText = entry.sharedPlainText %}
{% set minimalist = entry.sharedMinimalist %}
{% set extraLight = entry.sharedExtraLightText %}
{% set light = entry.sharedLightText %}
{% set medium = entry.sharedMediumText %}
{% set full = entry.sharedFullText %}

{% block content %}
    {% if plainText %}
    <div class="mb-4">
        <p>{{ plainText }}</p>
    </div>
    {% endif %}

    {% if minimalist %}
    <div class="mb-4">
        <p>{{ minimalist }}</p>
    </div>
    {% endif %}

    {% if extraLight %}
    <div class="mb-4">
        <div class="richtext">{{ extraLight }}</div>
    </div>
    {% endif %}

    {% if light %}
    <div class="mb-4">
        <div class="richtext">{{ light }}</div>
    </div>
    {% endif %}

    {% if medium %}
    <div class="mb-4">
        <div class="richtext">{{ medium }}</div>
    </div>
    {% endif %}
    
    {% if full %}
    <div class="mb-4">
        <div class="richtext">{{ full }}</div>
    </div>
    {% endif %}

    {# Modules #}
    {# {{ include('_matrix/main', {
        entry: entry
    }, with_context = false, ignore_missing = true) }} #}
{% endblock %}